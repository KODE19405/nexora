# Nexora AI Assistance — konfigurasi server (salin ke .env atau set di environment)
# JANGAN commit nilai asli API key ke git.

# API key penyedia AI (wajib agar /api/ai aktif). Contoh penyedia yang kompatibel
# dengan OpenAI Chat Completions: OpenAI, Groq, OpenRouter, Together, endpoint lokal Ollama/vLLM.
AI_API_KEY=

# Opsional — default: https://api.openai.com/v1
# Contoh lain:
#   AI_BASE_URL=https://openrouter.ai/api/v1
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_BASE_URL=http://127.0.0.1:11434/v1   (Ollama, API key tetap wajib diisi bebas, mis. "ollama")
AI_BASE_URL=https://api.openai.com/v1

# Opsional — default: gpt-4o-mini
AI_MODEL=gpt-4o-mini

# Opsional — bind server lokal
HOST=127.0.0.1
PORT=8787
